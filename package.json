{
  "name": "uzanet",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "start": "node .output/server/index.mjs",
    "test": "node --test tests/*.test.ts",
    "test:integration": "node --test tests/integration.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:integration",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "nuxt typecheck"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "nuxt": "^4.5.2",
    "vue": "^3.5.33",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@types/node": "^24.13.3",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.14",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.11"
  }
}
