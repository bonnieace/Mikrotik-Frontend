# Server-only configuration. No credentials belong in NUXT_PUBLIC_* variables.
NUXT_API_BASE=https://api.uzanet.co.ke/api/v1
# Exact browser origin; no trailing slash. Use your real HTTPS portal domain in production.
NUXT_SITE_ORIGIN=http://localhost:3000
# Exact RouterOS login URL for each public portal slug (optional; enables Connect).
NUXT_PUBLIC_HOTSPOT_LOGIN_URLS='{}'
# Set only behind a trusted edge that overwrites this header and blocks direct app access.
NUXT_CUSTOMER_IP_HEADER=
